---
const currentYear = new Date().getFullYear();
---

<hr class="footer-divider" />
<footer class="site-footer">
  <p>
    Licensed under <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      target="_blank"
      rel="noopener noreferrer">CC BY-NC-SA 4.0</a
    >.
  </p>
  <p class="credit">
    Powered by <a
      href="https://astro.build/"
      target="_blank"
      rel="noopener noreferrer">Astro</a
    >, theme based on <a
      href="https://github.com/Laurenfrost/tufte-like-astro-blog"
      target="_blank"
      rel="noopener noreferrer">Tufte Style Blog</a
    >
    .
  </p>
  <p class="copyright">
    &copy; {currentYear} Great Thunder Brother. All rights reserved.
  </p>
</footer>

<style>
  .footer-divider {
    border: none;
    border-top: 1px solid #ccc;
    margin: 3rem 0 0;
  }

  .site-footer {
    padding: 1.5rem 0 2rem;
    font-size: 0.85rem;
    color: #666;
  }

  .site-footer p {
    margin: 0.3rem 0;
  }

  .site-footer a {
    color: #555;
  }

  .site-footer a:hover {
    color: #111;
  }

  @media (max-width: 767px) {
    .site-footer {
      padding: 1rem 0 1.5rem;
      font-size: 0.8rem;
    }
  }
</style>
